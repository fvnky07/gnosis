{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "fs",
  "description": "Filesystem access scoped to the user-selected vault directory.",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "/Volumes/**" }
      ]
    }
  ]
}
