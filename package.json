{
	"name": "gnosis",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.5",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"test": "turbo test",
		"dev:desktop": "turbo -F @gnosis/desktop dev",
		"dev:web": "turbo -F @gnosis/web dev",
		"dev:docs": "turbo -F @gnosis/docs dev",
		"dev:mobile": "turbo -F @gnosis/mobile dev",
		"tauri:dev": "turbo -F @gnosis/desktop tauri:dev",
		"tauri:build": "turbo -F @gnosis/desktop tauri:build",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@gnosis/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@gnosis/config": "workspace:*",
		"@types/node": "^22",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"turbo": "^2.8.12",
		"typescript": "^6"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.13"
}
